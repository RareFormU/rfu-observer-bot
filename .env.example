# Discord
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_alert_channel_id_here
DISCORD_GUILD_ID=your_server_id_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Roles assigned after NFT verification
ELITE_OBSERVER_ROLE_ID=your_elite_observer_role_id_here
INNER_CIRCLE_ROLE_ID=your_inner_circle_role_id_here

# Solana RPC (free public — swap for Helius/QuickNode if rate limited)
SOLANA_RPC=https://api.mainnet-beta.solana.com

# RFU on-chain program (rfu-agent-receiver)
RFU_RECEIVER_PROGRAM_ID=your_program_id_here

# Accepted payment mint (USDC mainnet default: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v)
RFU_ACCEPTED_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Wallet link store path (default: ./wallet-links.json — override for persistent volume mounts)
# WALLET_LINKS_PATH=/data/wallet-links.json

# Webhook authentication secret for /agent-alert endpoint
AGENT_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: override alert thresholds (USD)
WHALE_THRESHOLD_USD=50000

# Agent introspection commands (/agent-status, /agent-escrow)
# RPC for devnet escrow queries (defaults to api.devnet.solana.com if unset)
AGENT_ESCROW_RPC=https://api.devnet.solana.com
# Default NFT mint for /agent-escrow when no argument is passed
DEFAULT_TEST_NFT_MINT=6jEUdE1FjhDZyfLQUgyufyxL8wm54SSjx2BpER2FMpiX
